# OCR API configuration template.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored and excluded from the Docker build context: put secrets there only.
# Every variable is optional; the value shown is the default. Read by docker-compose.yml,
# run_vllm.sh and main.py (variables already set in the shell take precedence).

# --- Security ---------------------------------------------------------------
# Comma-separated keys accepted in the X-API-Key header of /extract/*.
# Empty disables authentication. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# --- API ----------------------------------------------------------------------
# vllm (production) or hf (model in-process, needs requirements-hf.txt; not in the Docker image)
INFERENCE_BACKEND=vllm
HOST=0.0.0.0
PORT=8070
# Host port published by Docker Compose
API_PORT=8070
MAX_UPLOAD_MB=10
MAX_NEW_TOKENS=512
# Image resolution for KTP/NPWP. Raise MAX_PIXELS if small text is misread.
MIN_PIXELS=200704
MAX_PIXELS=1003520
# Upper bound of the vision processor (hf backend). Keep >= the largest per-document limit.
VISION_MAX_PIXELS=2508800

# --- Model ----------------------------------------------------------------------
# Served name shared by vLLM (--served-model-name) and the API; one value keeps them in sync.
VLLM_MODEL=qwen-ktp
# Local weights directory and the Hugging Face id downloaded into it if empty (hf backend).
MODEL_DIR=model/
MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct

# --- vLLM -------------------------------------------------------------------------
# API -> vLLM address. run_vllm.sh/screen setup only; Compose always uses http://vllm:8071.
VLLM_URL=http://127.0.0.1:8071
VLLM_TIMEOUT=120
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
# Fraction of GPU memory (0.40 ≈ 9.5 GB of 24 GB)
VLLM_GPU_UTIL=0.40
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=8
# Docker Compose: no-enforce-eager tries CUDA graphs (needs nvcc in the image)
VLLM_EAGER=enforce-eager
